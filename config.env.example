# Copy to config.env to opt in to file-based settings. Shell variables and
# bootstrap's provider/profile flags can override the values below.

# Only wsl-kind is implemented. The k3s profiles are reserved for future use.
ENV=wsl-kind
CLUSTER_NAME=kubeconsandbox

# bootstrap, platform, identity, agents, delegation, or full
# full is an alias for delegation. Model provider selection controls layer 5.
PROFILE=delegation

# Leave the URL empty to mirror this repository into the in-cluster Gitea.
REPO_URL=
REPO_REVISION=main

# Services use <name>.<domain>. localtest.me resolves to loopback.
BASE_DOMAIN=localtest.me

# stub uses deterministic replies without credentials. anthropic uses the key
# below. vllm serves a local CPU model. All three route through Agent Router.
MODEL_PROVIDER=vllm

# On setup, OpenBao stores the Anthropic key for Agent Router. To rotate it,
# update the key and rerun bootstrap with --force openbao.
MODEL_NAME=claude-sonnet-5-5
MODEL_API_KEY=

# Supply a Hugging Face ID or URL, optionally with a pinned revision.
# Empty settings select the model in versions.yaml and resolve its revision.
# Each vLLM replica loads the full model. See docs/model-sizing.md.
VLLM_MODEL=
VLLM_MODEL_REVISION=
VLLM_REPLICAS=1
VLLM_MAX_TOKENS=8192
